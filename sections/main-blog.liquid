<div style="max-width:72rem;margin:0 auto;padding:8rem 1.5rem 4rem;color:var(--ink);">
  <h1 style="font-size:clamp(2.5rem,7vw,4.5rem);margin-bottom:2rem;">{{ blog.title }}</h1>
  <div style="display:grid;grid-template-columns:repeat(auto-fill,minmax(16rem,1fr));gap:2rem;">
    {%- for article in blog.articles -%}
      <a href="{{ article.url }}" style="color:var(--ink);text-decoration:none;">
        {%- if article.image -%}<img src="{{ article.image | image_url: width: 500 }}" alt="{{ article.title }}" style="border-radius:1rem;">{%- endif -%}
        <p style="margin-top:.5rem;font-weight:600;">{{ article.title }}</p>
        <p style="opacity:.7;font-size:.9rem;">{{ article.published_at | date: '%B %d, %Y' }}</p>
      </a>
    {%- endfor -%}
  </div>
</div>
{% schema %}{ "name": "Blog" }{% endschema %}
