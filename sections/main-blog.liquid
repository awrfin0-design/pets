<section class="prose-wrap catalog">
  <h1 class="heading">{{ blog.title }}</h1>
  {%- paginate blog.articles by 12 -%}
    <div class="grid">
      {%- for article in blog.articles -%}
        <a class="product-card" href="{{ article.url }}">
          <span class="product-card__media">
            {%- if article.image -%}<img src="{{ article.image | image_url: width: 600 }}" alt="{{ article.image.alt | default: article.title | escape }}" loading="lazy" width="600" height="600">{%- else -%}{{ 'lifestyle-1' | placeholder_svg_tag: 'placeholder' }}{%- endif -%}
          </span>
          <span class="product-card__title">{{ article.title }}</span>
          <span class="product-card__price">{{ article.published_at | time_tag: '%B %d, %Y' }}</span>
        </a>
      {%- endfor -%}
    </div>
    {%- if paginate.pages > 1 -%}
      <nav class="pagination">
        {%- if paginate.previous -%}<a class="pill pill--dark" href="{{ paginate.previous.url }}">{{ 'general.pagination.previous' | t }}</a>{%- endif -%}
        <span>{{ paginate.current_page }} / {{ paginate.pages }}</span>
        {%- if paginate.next -%}<a class="pill pill--dark" href="{{ paginate.next.url }}">{{ 'general.pagination.next' | t }}</a>{%- endif -%}
      </nav>
    {%- endif -%}
  {%- endpaginate -%}
</section>
{% schema %}{ "name": "Blog" }{% endschema %}
