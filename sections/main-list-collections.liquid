<div style="max-width:72rem;margin:0 auto;padding:8rem 1.5rem 4rem;color:var(--ink);">
  <h1 style="font-size:clamp(2.5rem,7vw,4.5rem);margin-bottom:2rem;">{{ 'general.collections.title' | t }}</h1>
  <div style="display:grid;grid-template-columns:repeat(auto-fill,minmax(14rem,1fr));gap:2rem;">
    {%- for collection in collections -%}
      <a href="{{ collection.url }}" style="color:var(--ink);text-decoration:none;">
        {%- if collection.featured_image -%}<img src="{{ collection.featured_image | image_url: width: 400 }}" alt="{{ collection.title }}" style="border-radius:1rem;">{%- endif -%}
        <p style="margin-top:.5rem;font-weight:600;">{{ collection.title }}</p>
      </a>
    {%- endfor -%}
  </div>
</div>
{% schema %}{ "name": "Collections list" }{% endschema %}
