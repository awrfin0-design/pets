<section class="prose-wrap catalog">
  <h1 class="heading">{{ 'general.collections.title' | t }}</h1>
  <div class="grid">
    {%- for collection in collections -%}
      <a class="product-card" href="{{ collection.url }}">
        <span class="product-card__media">
          {%- if collection.featured_image -%}<img src="{{ collection.featured_image | image_url: width: 600 }}" alt="{{ collection.title | escape }}" loading="lazy" width="600" height="600">{%- else -%}{{ 'collection-1' | placeholder_svg_tag: 'placeholder' }}{%- endif -%}
        </span>
        <span class="product-card__title">{{ collection.title }}</span>
      </a>
    {%- endfor -%}
  </div>
</section>
{% schema %}{ "name": "Collections list" }{% endschema %}
