<section class="hero" style="--hero-bg:{{ section.settings.bg_color }};--hero-ink:{{ section.settings.text_color }}">
  <div class="hero__bg" aria-hidden="true" style="background-image:url({{ 'pattern-shards.svg' | asset_url }})"></div>
  <div class="hero__inner">
    <div class="hero__copy" data-reveal>
      <h1 class="display">{{ section.settings.title }}</h1>
      <p class="hero__text">{{ section.settings.text }}</p>
      {%- if section.settings.button_label != blank -%}
        <a class="btn" href="{{ section.settings.button_link | default: routes.all_products_collection_url }}">{{ section.settings.button_label }}</a>
      {%- endif -%}
    </div>
    <div class="hero__media" data-reveal>
      {%- if section.settings.image != blank -%}
        <img class="hero__img" src="{{ section.settings.image | image_url: width: 1100 }}" alt="{{ section.settings.image.alt | escape }}" width="{{ section.settings.image.width }}" height="{{ section.settings.image.height }}" fetchpriority="high">
      {%- else -%}
        <div class="hero__placeholder">{{ 'product-1' | placeholder_svg_tag }}</div>
      {%- endif -%}
    </div>
  </div>
  {%- if section.settings.usp_line_1 != blank or section.settings.usp_line_2 != blank -%}
    <div class="usp-bar">
      <strong>{{ section.settings.usp_line_1 }}</strong>
      <span>{{ section.settings.usp_line_2 }}</span>
    </div>
  {%- endif -%}
</section>

{% schema %}
{
  "name": "Hero",
  "settings": [
    { "type": "text", "id": "title", "label": "Headline", "default": "Dress your best friend" },
    { "type": "textarea", "id": "text", "label": "Text", "default": "Cosy knits, rain-proof jackets and bandanas made with a slight twist, so they look amazing and feel even better." },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "Shop now" },
    { "type": "url", "id": "button_link", "label": "Button link" },
    { "type": "image_picker", "id": "image", "label": "Hero image (transparent PNG works best)" },
    { "type": "color", "id": "bg_color", "label": "Background", "default": "#137563" },
    { "type": "color", "id": "text_color", "label": "Text color", "default": "#fdfbb8" },
    { "type": "header", "content": "Benefits bar" },
    { "type": "text", "id": "usp_line_1", "label": "Line 1 (bold white)", "default": "SOFT FABRICS · SAFE DYES · REFLECTIVE DETAILS" },
    { "type": "text", "id": "usp_line_2", "label": "Line 2 (cream)", "default": "MACHINE WASHABLE · TRUE-TO-SIZE · FREE RETURNS" }
  ],
  "presets": [{ "name": "Hero" }]
}
{% endschema %}
