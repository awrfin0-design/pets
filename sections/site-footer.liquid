<footer class="footer">
  <div class="footer__inner">
    <div class="footer__badge" aria-hidden="true">
      {%- if settings.logo != blank -%}
        <img src="{{ settings.logo | image_url: width: 500 }}" alt="" width="250" height="{{ 250 | divided_by: settings.logo.aspect_ratio | round }}">
      {%- else -%}
        {% render 'icon', name: 'paw' %}
        <span>{{ shop.name }}</span>
      {%- endif -%}
    </div>

    <div class="footer__links">
      {%- for link in linklists[section.settings.menu].links -%}
        <a href="{{ link.url }}">{{ link.title }}</a>
      {%- endfor -%}
      {%- assign has_social = false -%}
      {%- if settings.social_instagram != blank or settings.social_facebook != blank or settings.social_tiktok != blank -%}{%- assign has_social = true -%}{%- endif -%}
      {%- if has_social -%}
        <p class="footer__social-title">{{ 'general.footer.social' | t }}</p>
        <div class="footer__social">
          {%- if settings.social_instagram != blank -%}<a href="{{ settings.social_instagram }}" aria-label="Instagram">{% render 'icon', name: 'instagram' %}</a>{%- endif -%}
          {%- if settings.social_facebook != blank -%}<a href="{{ settings.social_facebook }}" aria-label="Facebook">{% render 'icon', name: 'facebook' %}</a>{%- endif -%}
          {%- if settings.social_tiktok != blank -%}<a href="{{ settings.social_tiktok }}" aria-label="TikTok">{% render 'icon', name: 'tiktok' %}</a>{%- endif -%}
        </div>
      {%- endif -%}
    </div>

    <div class="footer__news">
      <h2>{{ section.settings.newsletter_title }}</h2>
      <p>{{ section.settings.newsletter_text }}</p>
      {%- form 'customer', id: 'footer-newsletter', class: 'footer__form' -%}
        <input type="hidden" name="contact[tags]" value="newsletter">
        <input type="email" name="contact[email]" placeholder="{{ 'general.newsletter.email_placeholder' | t }}" aria-label="{{ 'general.newsletter.email_placeholder' | t }}" required>
        <button type="submit" class="btn btn--dark">{{ 'general.newsletter.subscribe' | t }}</button>
        {%- if form.posted_successfully? -%}<p class="form-ok">{{ 'general.newsletter.success' | t }}</p>{%- endif -%}
      {%- endform -%}
      {%- if section.settings.contact_note != blank -%}
        <p class="footer__note">{{ section.settings.contact_note }}{% if section.settings.contact_email != blank %} <a href="mailto:{{ section.settings.contact_email }}">{{ section.settings.contact_email }}</a>{% endif %}</p>
      {%- endif -%}
    </div>
  </div>

  <div class="footer__legal">
    <nav>
      {%- for link in linklists[section.settings.legal_menu].links -%}
        <a href="{{ link.url }}">{{ link.title }}</a>
      {%- endfor -%}
    </nav>
    <p>&copy; {{ 'now' | date: '%Y' }} {{ shop.name }} · {{ 'general.footer.rights' | t }}</p>
  </div>
</footer>

{% schema %}
{
  "name": "Footer",
  "settings": [
    { "type": "link_list", "id": "menu", "label": "Main links", "default": "footer" },
    { "type": "link_list", "id": "legal_menu", "label": "Legal links (privacy, refunds, shipping, terms)", "default": "legal" },
    { "type": "text", "id": "newsletter_title", "label": "Newsletter title", "default": "Tails are wagging" },
    { "type": "textarea", "id": "newsletter_text", "label": "Newsletter text", "default": "Sign up for the latest drops and news and we'll send you 10% off your first order as a thank you." },
    { "type": "text", "id": "contact_note", "label": "Contact note", "default": "For wholesale and stockist enquiries please email us at" },
    { "type": "text", "id": "contact_email", "label": "Contact email" }
  ]
}
{% endschema %}
