<section class="page-header page-header--compact" style="--hero-bg:var(--teal);--hero-ink:var(--cream)">
  <div class="hero__bg" aria-hidden="true" style="background-image:url({{ 'pattern-shards.svg' | asset_url }})"></div>
  <div class="page-header__inner">
    <h1 class="display">{{ collection.title }}</h1>
    {%- if collection.description != blank -%}<div class="hero__text">{{ collection.description }}</div>{%- endif -%}
  </div>
</section>

<section class="catalog">
  {%- paginate collection.products by section.settings.per_page -%}
    <form class="catalog__bar" method="get" data-filter-form>
      <details class="filters">
        <summary class="pill pill--dark">{{ 'general.collection.filter' | t }}</summary>
        <div class="filters__panel">
          {%- for filter in collection.filters -%}
            <fieldset>
              <legend>{{ filter.label }}</legend>
              {%- case filter.type -%}
                {%- when 'list' or 'boolean' -%}
                  {%- for value in filter.values -%}
                    <label class="check">
                      <input type="checkbox" name="{{ value.param_name }}" value="{{ value.value }}" {% if value.active %}checked{% endif %} {% if value.count == 0 and value.active == false %}disabled{% endif %}>
                      <span>{{ value.label }} <small>({{ value.count }})</small></span>
                    </label>
                  {%- endfor -%}
                {%- when 'price_range' -%}
                  <div class="price-range">
                    <input type="number" name="{{ filter.min_value.param_name }}" placeholder="0" min="0" max="{{ filter.range_max | money_without_currency | remove: ',' }}" {% if filter.min_value.value %}value="{{ filter.min_value.value | money_without_currency | remove: ',' }}"{% endif %} aria-label="min">
                    <span>–</span>
                    <input type="number" name="{{ filter.max_value.param_name }}" placeholder="{{ filter.range_max | money_without_currency | remove: ',' }}" min="0" {% if filter.max_value.value %}value="{{ filter.max_value.value | money_without_currency | remove: ',' }}"{% endif %} aria-label="max">
                  </div>
              {%- endcase -%}
            </fieldset>
          {%- endfor -%}
          <div class="filters__actions">
            <button type="submit" class="btn btn--small">{{ 'general.collection.apply' | t }}</button>
            <a href="{{ collection.url }}" class="link">{{ 'general.collection.clear' | t }}</a>
          </div>
        </div>
      </details>

      <p class="catalog__count">{{ 'general.collection.products' | t: count: collection.products_count }}</p>

      <label class="sort">
        <span>{{ 'general.collection.sort_by' | t }}</span>
        <select name="sort_by" onchange="this.form.submit()">
          {%- assign sort_by = collection.sort_by | default: collection.default_sort_by -%}
          {%- for option in collection.sort_options -%}
            <option value="{{ option.value }}" {% if option.value == sort_by %}selected{% endif %}>{{ option.name }}</option>
          {%- endfor -%}
        </select>
      </label>
    </form>

    {%- if collection.products.size > 0 -%}
      <div class="grid">
        {%- for product in collection.products -%}
          {% render 'product-card', product: product %}
        {%- endfor -%}
      </div>
    {%- else -%}
      <p class="empty">{{ 'general.collection.empty' | t }}</p>
    {%- endif -%}

    {%- if paginate.pages > 1 -%}
      <nav class="pagination" aria-label="Pagination">
        {%- if paginate.previous -%}<a class="pill pill--dark" href="{{ paginate.previous.url }}">{{ 'general.pagination.previous' | t }}</a>{%- endif -%}
        <span>{{ paginate.current_page }} / {{ paginate.pages }}</span>
        {%- if paginate.next -%}<a class="pill pill--dark" href="{{ paginate.next.url }}">{{ 'general.pagination.next' | t }}</a>{%- endif -%}
      </nav>
    {%- endif -%}
  {%- endpaginate -%}
</section>

{% schema %}
{
  "name": "Collection",
  "settings": [
    { "type": "range", "id": "per_page", "label": "Products per page", "min": 8, "max": 36, "step": 4, "default": 24 }
  ]
}
{% endschema %}
