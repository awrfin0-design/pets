<article class="prose-wrap">
  <h1 class="heading">{{ article.title }}</h1>
  <p class="eyebrow">{{ article.published_at | time_tag: '%B %d, %Y' }}{% if article.author %} · {{ article.author }}{% endif %}</p>
  {%- if article.image -%}<img class="article__img" src="{{ article.image | image_url: width: 1200 }}" alt="{{ article.image.alt | default: article.title | escape }}" width="{{ article.image.width }}" height="{{ article.image.height }}">{%- endif -%}
  <div class="prose">{{ article.content }}</div>
</article>
{% schema %}{ "name": "Article" }{% endschema %}
