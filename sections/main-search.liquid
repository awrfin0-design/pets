<section class="prose-wrap catalog">
  <h1 class="heading">{{ 'general.search.title' | t }}</h1>
  <form class="search-form" action="{{ routes.search_url }}" method="get" role="search">
    <input type="search" name="q" value="{{ search.terms | escape }}" placeholder="{{ 'general.search.placeholder' | t }}" aria-label="{{ 'general.search.placeholder' | t }}">
    <input type="hidden" name="type" value="product,article,page">
    <button class="btn" type="submit">{{ 'general.search.title' | t }}</button>
  </form>
  {%- if search.performed -%}
    {%- paginate search.results by 24 -%}
      <p class="catalog__count">{{ 'general.search.results_count' | t: count: search.results_count }}</p>
      <div class="grid">
        {%- for item in search.results -%}
          {%- if item.object_type == 'product' -%}
            {% render 'product-card', product: item %}
          {%- else -%}
            <a class="product-card" href="{{ item.url }}">
              <span class="product-card__media">
                {%- if item.image -%}<img src="{{ item.image | image_url: width: 600 }}" alt="" loading="lazy" width="600" height="600">{%- else -%}{{ 'lifestyle-1' | placeholder_svg_tag: 'placeholder' }}{%- endif -%}
              </span>
              <span class="product-card__title">{{ item.title }}</span>
            </a>
          {%- endif -%}
        {%- endfor -%}
      </div>
      {%- if paginate.pages > 1 -%}
        <nav class="pagination">
          {%- if paginate.previous -%}<a class="pill pill--dark" href="{{ paginate.previous.url }}">{{ 'general.pagination.previous' | t }}</a>{%- endif -%}
          <span>{{ paginate.current_page }} / {{ paginate.pages }}</span>
          {%- if paginate.next -%}<a class="pill pill--dark" href="{{ paginate.next.url }}">{{ 'general.pagination.next' | t }}</a>{%- endif -%}
        </nav>
      {%- endif -%}
    {%- endpaginate -%}
  {%- endif -%}
</section>
{% schema %}{ "name": "Search" }{% endschema %}
