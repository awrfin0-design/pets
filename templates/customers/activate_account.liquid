<section class="prose-wrap narrow">
  <h1 class="heading">{{ 'general.customer.activate_account' | t }}</h1>
  {%- form 'activate_customer_password', class: 'stack-form' -%}
    {{ form.errors | default_errors }}
    <label>{{ 'general.customer.password' | t }}<input type="password" name="customer[password]" autocomplete="new-password" required></label>
    <label>{{ 'general.customer.password_confirm' | t }}<input type="password" name="customer[password_confirmation]" autocomplete="new-password" required></label>
    <button type="submit" class="btn">{{ 'general.customer.activate_account' | t }}</button>
  {%- endform -%}
</section>
