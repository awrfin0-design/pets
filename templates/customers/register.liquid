<section class="prose-wrap narrow">
  <h1 class="heading">{{ 'general.customer.create_account' | t }}</h1>
  {%- form 'create_customer', class: 'stack-form' -%}
    {{ form.errors | default_errors }}
    <label>{{ 'general.customer.first_name' | t }}<input type="text" name="customer[first_name]" autocomplete="given-name"></label>
    <label>{{ 'general.customer.last_name' | t }}<input type="text" name="customer[last_name]" autocomplete="family-name"></label>
    <label>{{ 'general.customer.email' | t }}<input type="email" name="customer[email]" autocomplete="email" required></label>
    <label>{{ 'general.customer.password' | t }}<input type="password" name="customer[password]" autocomplete="new-password" required></label>
    <button type="submit" class="btn">{{ 'general.customer.create_account' | t }}</button>
  {%- endform -%}
</section>
