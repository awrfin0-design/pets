<section class="prose-wrap narrow">
  <h1 class="heading">{{ 'general.customer.login' | t }}</h1>
  {%- form 'customer_login', class: 'stack-form' -%}
    {{ form.errors | default_errors }}
    <label>{{ 'general.customer.email' | t }}<input type="email" name="customer[email]" autocomplete="email" required></label>
    {%- if form.password_needed -%}
      <label>{{ 'general.customer.password' | t }}<input type="password" name="customer[password]" autocomplete="current-password" required></label>
    {%- endif -%}
    <button type="submit" class="btn">{{ 'general.customer.sign_in' | t }}</button>
    <a class="link" href="{{ routes.account_register_url }}">{{ 'general.customer.create_account' | t }}</a>
  {%- endform -%}
</section>
