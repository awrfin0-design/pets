<div style="max-width:28rem;margin:0 auto;padding:8rem 1.5rem 4rem;">
  <h1 style="font-size:2rem;margin-bottom:1.5rem;">{{ 'general.customer.reset_password' | t }}</h1>
  {%- form 'reset_customer_password' -%}
    {{ form.errors | default_errors }}
    <input type="password" name="customer[password]" placeholder="{{ 'general.customer.password' | t }}" required style="width:100%;padding:.75rem;margin-bottom:1rem;">
    <input type="password" name="customer[password_confirmation]" placeholder="{{ 'general.customer.password_confirm' | t }}" required style="width:100%;padding:.75rem;margin-bottom:1rem;">
    <button type="submit" class="hero-button" style="background:var(--coral);color:var(--cream);border:none;">{{ 'general.customer.reset_password' | t }}</button>
  {%- endform -%}
</div>
