<section class="prose-wrap">
  <h1 class="heading">{{ 'general.customer.order' | t }} {{ order.name }}</h1>
  <p>{{ order.created_at | date: '%B %d, %Y' }}</p>
  {%- for line_item in order.line_items -%}
    <p>{{ line_item.title }} &times; {{ line_item.quantity }} &mdash; {{ line_item.final_line_price | money }}</p>
  {%- endfor -%}
  <p><b>{{ 'general.cart.total' | t }}: {{ order.total_price | money }}</b></p>
</section>
