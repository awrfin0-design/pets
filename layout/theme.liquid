<!doctype html>
<html class="no-js" lang="{{ request.locale.iso_code }}" dir="{{ settings.text_direction | default: 'ltr' }}">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<meta name="theme-color" content="{{ settings.color_teal }}">
<title>{{ page_title }}{% unless page_title contains shop.name %} &ndash; {{ shop.name }}{% endunless %}</title>
{% if page_description %}<meta name="description" content="{{ page_description | escape }}">{% endif %}
<link rel="canonical" href="{{ canonical_url }}">
{% if settings.favicon %}<link rel="icon" href="{{ settings.favicon | image_url: width: 64 }}" type="image/png">{% endif %}

<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wght@12..96,600;12..96,800&family=Figtree:wght@400;500;600;700&display=swap" rel="stylesheet">

{{ content_for_header }}

<style>
  :root {
    --teal: {{ settings.color_teal }};
    --teal-deep: {{ settings.color_teal_deep }};
    --cream: {{ settings.color_cream }};
    --paper: {{ settings.color_paper }};
    --pink: {{ settings.color_pink }};
    --cyan: {{ settings.color_cyan }};
    --red: {{ settings.color_red }};
    --green: {{ settings.color_green }};
  }
</style>
<link rel="stylesheet" href="{{ 'theme.css' | asset_url }}">
<script>document.documentElement.className = document.documentElement.className.replace('no-js', 'js');</script>
<script>window.themeRoutes ={ cart: {{ routes.cart_url | json }}, recs: {{ routes.product_recommendations_url | json }} };</script>
<script src="{{ 'theme.js' | asset_url }}" defer></script>
</head>
<body class="template-{{ template.name }}">
<a class="skip-link" href="#MainContent">{{ 'general.skip' | t }}</a>

{% section 'site-header' %}

<main id="MainContent">
  {{ content_for_layout }}
</main>

{% section 'site-footer' %}
</body>
</html>
